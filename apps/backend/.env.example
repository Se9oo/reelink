# 운영 서버 기준 예시. 서버의 ~/reelink/apps/backend/.env에 두고 docker compose가 env_file로 읽는다.
# 비밀번호는 루트 .env의 DB_PASSWORD와 같아야 한다
DATABASE_URL=postgresql://reelink:여기에_안전한_비밀번호@postgres:5432/reelink
# openssl rand -hex 32 로 만든다
JWT_SECRET=change_me
JWT_EXPIRES_IN=15m
PORT=3000
REDIS_URL=redis://redis:6379
FRONTEND_URL=https://도메인
# Nginx 뒤(/api 접두사)로 배포할 때만 설정. 없으면 /auth
REFRESH_COOKIE_PATH=/api/auth

# kakao
KAKAO_CLIENT_ID=change_me
KAKAO_CLIENT_SECRET=change_me
KAKAO_CALLBACK_URL=https://도메인/api/auth/kakao/callback
KAKAO_NOTIFY_CALLBACK_URL=https://도메인/api/notifications/kakao/callback
# 오픈빌더 스킬 요청에 실리는 x-webhook-secret 헤더 값
KAKAO_WEBHOOK_SECRET=change_me

# google
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
GOOGLE_CALLBACK_URL=https://도메인/api/auth/google/callback

# github
GITHUB_CLIENT_ID=change_me
GITHUB_CLIENT_SECRET=change_me
GITHUB_CALLBACK_URL=https://도메인/api/auth/github/callback
