DATABASE_URL=postgresql://reelink:여기에_안전한_비밀번호@postgres:5432/reelink
JWT_SECRET=change_me
JWT_EXPIRES_IN=change_me
JWT_REFRESH_EXPIRES_IN=change_me
PORT=3000
REDIS_URL=redis://redis:6379
# 오픈빌더 스킬 요청에 실리는 x-webhook-secret 헤더 값
KAKAO_WEBHOOK_SECRET=change_me
